# ============================================================
# OmniGuard SOC - Variables de Entorno (Ejemplo)
# Copia este archivo a .env y rellena los valores reales
# NUNCA commitees el .env real (está en .gitignore)
# ============================================================

# --- General ---
PROJECT_NAME=omniguard
REGISTRY=ghcr.io/tu-usuario-o-org
VERSION=latest
LOG_LEVEL=INFO

# --- Base de Datos ---
DB_USER=omniguard
# DB_PASSWORD se lee desde secret: ./secrets/db_password.txt

# --- PASETO Keys (genera con: openssl rand -base64 32) ---
# PASETO_PRIVATE_KEY se lee desde secret: ./secrets/paseto_private_key.txt
# PASETO_PUBLIC_KEY se lee desde secret: ./secrets/paseto_public_key.txt

# --- Grafana ---
GRAFANA_USER=admin
# GRAFANA_PASSWORD se lee desde secret: ./secrets/grafana_password.txt

# --- Dominio / TLS (para nginx) ---
DOMAIN=omniguard.tu-dominio.com
# Certificados en ./certs/ (fullchain.pem, privkey.pem)

# --- Notificaciones (para analyzer - referencia) ---
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Extras ---
# SENTRY_DSN=
# VAULT_ADDR=